# Copy to .env and fill in. .env is gitignored.

# --- Which model backend the investigation assistant uses ----------------
# auto      prefer Claude if a key is set, else a local Ollama server,
#           else the deterministic templates  (default)
# claude    Anthropic API. Best quality. Costs roughly 5-10 cents per run.
# ollama    A model running locally. Free, offline, no account needed.
# template  No model at all. Field interpolation only.
SOC_AI_PROVIDER=auto

# --- Option 1: Claude (paid) --------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
# Billing is separate from a Claude.ai subscription. Set a spend limit.
ANTHROPIC_API_KEY=
# SOC_AI_MODEL=claude-opus-5
# SOC_AI_EFFORT=medium          # low | medium | high | xhigh | max
# SOC_AI_MAX_TOKENS=4000

# --- Option 2: Ollama (free, local) -------------------------------------
# Install:  brew install ollama && brew services start ollama
# Pull:     ollama pull llama3.2:3b
# llama3.2:3b (~2GB) runs alongside Wazuh on 8GB of RAM.
# For better analysis on a machine with Wazuh stopped, try qwen2.5:7b (~4.7GB).
# SOC_AI_OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://127.0.0.1:11434
# SOC_AI_OLLAMA_TIMEOUT=300     # seconds; local generation is slow
# SOC_AI_OLLAMA_NUM_CTX=8192    # lower this if the model is memory-starved

# --- Wazuh indexer ------------------------------------------------------
# Defaults match the stock single-node wazuh-docker deployment.
# Change the indexer password in wazuh-docker/single-node/docker-compose.yml
# before using this outside a local lab.
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword
WAZUH_MIN_LEVEL=4
WAZUH_WINDOW_MINUTES=120
# WAZUH_FETCH_CEILING=1500      # alerts pulled per request before triage
